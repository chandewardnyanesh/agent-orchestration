# ── LLM Providers (plug in your keys) ─────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Which model to use for each role
SUPERVISOR_MODEL=claude-opus-4-6          # or gpt-4o
SPECIALIST_MODEL=claude-sonnet-4-6        # or gpt-4o-mini
REVIEWER_MODEL=claude-haiku-4-5-20251001  # fast + cheap for review

# ── Database ──────────────────────────────────────────────────
POSTGRES_USER=agent
POSTGRES_PASSWORD=secret
POSTGRES_DB=orchestration
DATABASE_URL=postgresql://agent:secret@postgres:5432/orchestration

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── ChromaDB ─────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION=agent_memory

# ── Agent settings ────────────────────────────────────────────
SUPERVISOR_CONFIDENCE_THRESHOLD=0.7   # below this → HITL escalation
REVIEWER_QUALITY_THRESHOLD=0.75       # below this → retry specialist
MAX_SPECIALIST_RETRIES=2
MAX_TASK_TIMEOUT_SECONDS=300

# ── Observability ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
ENABLE_COST_TRACKING=true

# ── Security ──────────────────────────────────────────────────
API_SECRET_KEY=change-me-in-production
CODE_EXECUTOR_SANDBOX=true
